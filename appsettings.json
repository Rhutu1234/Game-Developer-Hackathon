{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureOpenAI": {
    "Endpoint": "https://your-azure-ai-endpoint.openai.azure.com/",
    "ApiKey": "YOUR_AZURE_OPENAI_API_KEY",
    "DeploymentName": "gpt-4o"
  },
  // TODO: Add your Ollama settings here In case you Don't have Azure OpenAI, you can use Ollama as an alternative. 
  // Please make sure to install Ollama and run it locally before using it.
  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "Model": "llama3.2"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  }
}